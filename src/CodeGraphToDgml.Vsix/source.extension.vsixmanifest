<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <!-- Version is resolved at build time from Directory.Build.props via the GetVsixVersion target. -->
    <Identity Id="CodeGraphToDgml.Vsix" Version="|%CurrentProject%;GetVsixVersion|" Language="en-US" Publisher="Luciano Evaristo Guerche" />
    <DisplayName>Code Graph to DGML</DisplayName>
    <Description xml:space="preserve">Visualize code relationships from C# and Visual Basic editors: call hierarchies and type references as DGML graphs, and call flows as Mermaid sequence diagrams.</Description>
    <MoreInfo>https://github.com/guercheLE/CodeGraphToDgml</MoreInfo>
    <License>LICENSE.txt</License>
    <ReleaseNotes>https://github.com/guercheLE/CodeGraphToDgml/blob/main/CHANGELOG.md</ReleaseNotes>
    <Icon>logo.png</Icon>
    <PreviewImage>logo.png</PreviewImage>
    <Tags>dgml;code-graph;call-hierarchy;references;roslyn;csharp;visual-basic;sequence-diagram;mermaid</Tags>
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,22.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,22.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,22.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,22.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,22.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,22.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework" Version="[4.8,)" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.14,22.0)" DisplayName="Visual Studio core editor" />
    <!-- The DGML editor is an optional individual component on Community and Professional; without it .dgml files cannot be opened. -->
    <Prerequisite Id="Microsoft.VisualStudio.Component.GraphDocument" Version="[17.14,22.0)" DisplayName="DGML editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" />
    <Asset Type="Microsoft.VisualStudio.Assembly" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%|" />
  </Assets>
</PackageManifest>
